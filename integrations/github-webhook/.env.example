# Copy to .env (never commit .env). The same value goes in GitHub -> repo Settings -> Webhooks -> Secret.
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=INFO
# Day 20: json (default, for log tools) or text (easier to read on a laptop)
LOG_FORMAT=json
# Day 19: Port API (same client ID / secret as Day 13; EU accounts use api.port.io)
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
PORT_API_URL=https://api.port.io/v1
